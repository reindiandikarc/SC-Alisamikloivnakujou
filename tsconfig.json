{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "target": "es2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "ts-node": {
    "transpileOnly": true,
    "esm": false
  },
  "include": ["**/*.js"],
  "exclude": ["node_modules"]
}
